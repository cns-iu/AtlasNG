{
  "name": "internal-storybook",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/internal/storybook/src",
  "prefix": "ang",
  "projectType": "library",
  "tags": ["internal", "layer:internal"],
  "targets": {
    "build-storybook": {
      "dependsOn": [
        {
          "projects": ["design-system", "labs", "content-blocks", "kg-explorer"],
          "target": "build-storybook"
        }
      ]
    },
    "storybook": {
      "dependsOn": [
        {
          "projects": ["design-system", "labs", "content-blocks", "kg-explorer"],
          "target": "storybook"
        }
      ]
    },
    "generate-palettes-scss": {
      "executor": "@atlasng/nx-plugin:generate-palettes-scss",
      "configurations": {
        "cns": {
          "input": "{projectRoot}/src/themes/cns/palette.tokens.json",
          "output": "{projectRoot}/src/themes/cns/_palettes.scss"
        },
        "hra": {
          "input": "{projectRoot}/src/themes/hra/palette.tokens.json",
          "output": "{projectRoot}/src/themes/hra/_palettes.scss"
        },
        "mhu": {
          "input": "{projectRoot}/src/themes/mhu/palette.tokens.json",
          "output": "{projectRoot}/src/themes/mhu/_palettes.scss"
        },
        "wpp": {
          "input": "{projectRoot}/src/themes/wpp/palette.tokens.json",
          "output": "{projectRoot}/src/themes/wpp/_palettes.scss"
        }
      }
    },
    "generate-shape-scss": {
      "executor": "@atlasng/nx-plugin:generate-shape-scss",
      "configurations": {
        "cns": {
          "input": "{projectRoot}/src/themes/cns/shape.tokens.json",
          "output": "{projectRoot}/src/themes/cns/_shape.scss"
        },
        "hra": {
          "input": "{projectRoot}/src/themes/hra/shape.tokens.json",
          "output": "{projectRoot}/src/themes/hra/_shape.scss"
        },
        "mhu": {
          "input": "{projectRoot}/src/themes/mhu/shape.tokens.json",
          "output": "{projectRoot}/src/themes/mhu/_shape.scss"
        },
        "wpp": {
          "input": "{projectRoot}/src/themes/wpp/shape.tokens.json",
          "output": "{projectRoot}/src/themes/wpp/_shape.scss"
        }
      }
    }
  }
}
