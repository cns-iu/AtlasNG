{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/libs/labs",
  "assets": [
    {
      "input": "src/sass",
      "glob": "**/*.scss",
      "output": "sass"
    }
  ],
  "lib": {
    "entryFile": "src/index.ts",
    "styleIncludePaths": ["./src/sass", "../design-system/src/sass"]
  }
}
