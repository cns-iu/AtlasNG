{
  "name": "labs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/labs/src",
  "prefix": "ang",
  "projectType": "library",
  "tags": ["library"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package"
    },
    "build-compodoc": {},
    "build-storybook": {
      "options": {
        "styles": ["libs/labs/.storybook/themes/all-themes.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/labs/src/sass"]
        }
      }
    },
    "compodoc": {},
    "pre-build-storybook": {},
    "pre-storybook": {},
    "serve-static-storybook": {},
    "storybook": {
      "options": {
        "styles": ["libs/labs/.storybook/themes/all-themes.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/labs/src/sass"]
        }
      }
    },
    "test": {
      "options": {
        "include": ["**/*.spec.ts", "../!(src|.storybook)/**/*.spec.ts"],
        "setupFiles": ["{projectRoot}/src/test-setup.ts"]
      }
    },
    "test-storybook": {},
    "nx-release-publish": {}
  }
}
