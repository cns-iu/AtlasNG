{
  "name": "labs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/labs/src",
  "prefix": "ang",
  "projectType": "library",
  "tags": ["library", "layer:labs"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package"
    },
    "check-sass": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "sass --no-source-map --load-path=dist/libs --load-path=node_modules tools/sass-smoke/labs.scss > /dev/null"
      }
    },
    "build-compodoc": {},
    "build-storybook": {
      "options": {
        "stylePreprocessorOptions": {
          "includePaths": ["libs/labs/src/sass", "libs/design-system/src/sass", "libs/internal/storybook/src/themes"]
        }
      }
    },
    "compodoc": {},
    "build-storybook-compodoc": {},
    "serve-static-storybook": {},
    "storybook": {
      "options": {
        "port": 4402,
        "stylePreprocessorOptions": {
          "includePaths": ["libs/labs/src/sass", "libs/design-system/src/sass", "libs/internal/storybook/src/themes"]
        }
      }
    },
    "test": {
      "options": {
        "setupFiles": ["{projectRoot}/src/test-setup.ts"]
      }
    },
    "test-storybook": {},
    "nx-release-publish": {}
  }
}
