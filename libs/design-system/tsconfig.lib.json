{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": ["**/*.ts", "table/**/*.ts"],
  "exclude": [
    ".storybook/**/*",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.stories.ts",
    "**/*.stories.js",
    "table/.storybook/**/*",
    "table/**/*.spec.ts",
    "table/**/*.test.ts",
    "table/**/*.stories.ts",
    "table/**/*.stories.js"
  ]
}
