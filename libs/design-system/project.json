{
  "name": "design-system",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/design-system/src",
  "prefix": "ang",
  "projectType": "library",
  "tags": ["library", "layer:design-system"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package"
    },
    "check-sass": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "sass --no-source-map --load-path=dist/libs --load-path=node_modules tools/sass-smoke/design-system.scss > /dev/null"
      }
    },
    "build-storybook": {
      "dependsOn": [
        "build-storybook-compodoc",
        {
          "projects": ["icons"],
          "target": "build"
        }
      ],
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/.storybook/**/*",
        {
          "dependentTasksOutputFiles": "**/*"
        },
        {
          "externalDependencies": ["storybook", "@storybook/angular"]
        }
      ]
    },
    "serve-static-storybook": {},
    "storybook": {
      "dependsOn": [
        "build-storybook-compodoc",
        {
          "projects": ["icons"],
          "target": "build"
        }
      ],
      "options": {
        "port": 4401
      }
    },
    "test": {
      "options": {
        "setupFiles": ["{projectRoot}/src/test-setup.ts"]
      }
    },
    "nx-release-publish": {}
  }
}
