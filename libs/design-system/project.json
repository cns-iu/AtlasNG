{
  "name": "design-system",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/design-system/src",
  "prefix": "ang",
  "projectType": "library",
  "tags": ["library"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package"
    },
    "build-compodoc": {},
    "build-storybook": {
      "options": {
        "styles": ["libs/design-system/.storybook/themes/all-themes.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/design-system/internal/scss"]
        }
      }
    },
    "compodoc": {},
    "pre-build-storybook": {},
    "pre-storybook": {},
    "serve-static-storybook": {},
    "storybook": {
      "options": {
        "styles": ["libs/design-system/.storybook/themes/all-themes.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/design-system/internal/scss"]
        }
      }
    },
    "test": {
      "options": {
        "include": [
          "**/*.spec.ts",
          "../!(src|.storybook)/**/*.spec.ts"
        ]
      }
    },
    "test-storybook": {},
    "nx-release-publish": {}
  }
}
