{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/libs/design-system",
  "assets": [
    {
      "input": "src/sass",
      "glob": "**/*.scss",
      "output": "sass"
    },
    "**/tokens.scss",
    "**/_tokens.scss"
  ],
  "lib": {
    "entryFile": "src/index.ts",
    "styleIncludePaths": ["./src/sass"]
  },
  "allowedNonPeerDependencies": ["^type-fest$"]
}
