{
  "name": "kg-explorer",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/applications/kg-explorer/src",
  "prefix": "ang",
  "projectType": "library",
  "tags": ["library", "layer:application"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package"
    },
    "build-compodoc": {},
    "build-storybook": {
      "options": {
        "styles": ["libs/internal/storybook/src/themes/all-themes.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/design-system/src/sass", "libs/internal/storybook/src/themes"]
        }
      }
    },
    "compodoc": {},
    "build-storybook-compodoc": {},
    "serve-static-storybook": {},
    "storybook": {
      "options": {
        "styles": ["libs/internal/storybook/src/themes/all-themes.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/design-system/src/sass", "libs/internal/storybook/src/themes"]
        }
      }
    },
    "test": {
      "options": {
        "include": ["**/*.spec.ts", "../!(src|.storybook)/**/*.spec.ts"],
        "setupFiles": ["{projectRoot}/src/test-setup.ts"]
      }
    },
    "test-storybook": {},
    "nx-release-publish": {}
  }
}
