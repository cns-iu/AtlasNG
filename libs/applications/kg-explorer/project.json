{
  "name": "kg-explorer",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/applications/kg-explorer/src",
  "prefix": "ang",
  "projectType": "library",
  "tags": ["library", "layer:app-library"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package"
    },
    "build-storybook": {
      "options": {
        "stylePreprocessorOptions": {
          "includePaths": ["libs/labs/src/sass", "libs/design-system/src/sass", "libs/internal/storybook/src/themes"]
        }
      }
    },
    "serve-static-storybook": {},
    "storybook": {
      "options": {
        "port": 4404,
        "stylePreprocessorOptions": {
          "includePaths": ["libs/labs/src/sass", "libs/design-system/src/sass", "libs/internal/storybook/src/themes"]
        }
      }
    },
    "test": {
      "options": {
        "setupFiles": ["{projectRoot}/src/test-setup.ts"]
      }
    },
    "nx-release-publish": {}
  }
}
