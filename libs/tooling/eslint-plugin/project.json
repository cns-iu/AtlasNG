{
  "name": "eslint-plugin",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/tooling/eslint-plugin",
  "projectType": "library",
  "tags": ["tooling", "layer:tooling"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "main": "{projectRoot}/index.js",
        "rootDir": "{projectRoot}",
        "outputPath": "{workspaceRoot}/dist/{projectRoot}",
        "tsConfig": "{projectRoot}/tsconfig.lib.json",
        "assets": ["{projectRoot}/README.md", "{projectRoot}/LICENSE"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": [
            "vitest",
            "@vitest/coverage-v8",
            "eslint",
            "@nx/eslint-plugin",
            "angular-eslint",
            "typescript-eslint",
            "eslint-plugin-jsonc",
            "eslint-plugin-storybook"
          ]
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "watch": {
          "command": "vitest"
        }
      }
    },
    "nx-release-publish": {}
  }
}
