{
  "name": "@atlasng/nx-plugin",
  "version": "0.0.0",
  "description": "Nx plugin with shared generators, executors, inferred targets and presets for AtlasNG and related Nx workspaces",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cns-iu/AtlasNG",
    "directory": "libs/tooling/nx-plugin"
  },
  "homepage": "https://github.com/cns-iu/AtlasNG/tree/main/libs/tooling/nx-plugin",
  "bugs": {
    "url": "https://github.com/cns-iu/AtlasNG/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json",
    "./generators.json": "./generators.json",
    "./executors.json": "./executors.json",
    "./migrations.json": "./migrations.json",
    "./presets/*": "./presets/*"
  },
  "generators": "./generators.json",
  "executors": "./executors.json",
  "nx-migrations": {
    "migrations": "./migrations.json"
  },
  "dependencies": {
    "@nx/devkit": "^23.2.0"
  },
  "peerDependencies": {
    "@atlasng/commitlint-config": "^0.0.0",
    "@atlasng/eslint-plugin": "^0.0.0",
    "@atlasng/prettier-config": "^0.0.0",
    "@atlasng/tsconfig": "^0.0.0",
    "nx": "^23.0.0"
  },
  "peerDependenciesMeta": {
    "@atlasng/commitlint-config": {
      "optional": true
    },
    "@atlasng/eslint-plugin": {
      "optional": true
    },
    "@atlasng/prettier-config": {
      "optional": true
    },
    "@atlasng/tsconfig": {
      "optional": true
    }
  }
}
