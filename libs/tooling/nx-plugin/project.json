{
  "name": "nx-plugin",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/tooling/nx-plugin/src",
  "projectType": "library",
  "tags": ["tooling", "layer:tooling"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "main": "{projectRoot}/src/index.ts",
        "rootDir": "{projectRoot}",
        "outputPath": "{workspaceRoot}/dist/{projectRoot}",
        "tsConfig": "{projectRoot}/tsconfig.lib.json",
        "assets": [
          "{projectRoot}/README.md",
          "{projectRoot}/LICENSE",
          "{projectRoot}/generators.json",
          "{projectRoot}/executors.json",
          "{projectRoot}/migrations.json",
          {
            "input": "{projectRoot}/presets",
            "glob": "**/*.json",
            "output": "presets"
          },
          {
            "input": "{projectRoot}/src",
            "glob": "**/schema.json",
            "output": "src"
          }
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", { "externalDependencies": ["vitest", "@vitest/coverage-v8"] }],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "watch": {
          "command": "vitest"
        }
      }
    },
    "nx-release-publish": {}
  }
}
