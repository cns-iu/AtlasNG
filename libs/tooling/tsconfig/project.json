{
  "name": "tsconfig",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/tooling/tsconfig",
  "projectType": "library",
  "tags": ["tooling", "layer:tooling"],
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}"]
    }
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", { "externalDependencies": ["vitest", "typescript"] }],
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "watch": {
          "command": "vitest"
        }
      }
    },
    "nx-release-publish": {
      "dependsOn": [],
      "options": {
        "packageRoot": "{projectRoot}"
      }
    }
  }
}
