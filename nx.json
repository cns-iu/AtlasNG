{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {}
    },
    {
      "plugin": "@nx/storybook/plugin",
      "options": {
        "buildStorybookTargetName": "build-storybook",
        "serveStorybookTargetName": "storybook",
        "staticStorybookTargetName": "serve-static-storybook",
        "testStorybookTargetName": "test-storybook"
      }
    }
  ],
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/AGENTS.md",
      "!{projectRoot}/README.md",
      "!{projectRoot}/CHANGELOG.md",
      "!{projectRoot}/**/*.mdx",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/**/test-setup.[jt]s",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.storybook.json",
      "!{projectRoot}/.storybook/**/*",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.github/workflows/ci.yml",
      "{workspaceRoot}/.github/workflows/nx-ci.yml",
      "{workspaceRoot}/.github/actions/setup-nx-workspace/action.yml"
    ]
  },
  "targetDefaults": {
    "@nx/angular:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "{workspaceRoot}/dist/{projectRoot}",
        "browser": "{projectRoot}/src/main.ts",
        "tsConfig": "{projectRoot}/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "styles": ["{projectRoot}/src/styles.scss"],
        "assets": [
          {
            "glob": "**/*",
            "input": "{projectRoot}/public"
          }
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true
        }
      }
    },
    "@nx/angular:package": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "{projectRoot}/ng-package.json",
        "tsConfig": "{projectRoot}/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "{projectRoot}/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "build-compodoc": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        {
          "externalDependencies": ["@compodoc/compodoc"]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/compodoc/{projectName}"],
      "options": {
        "commands": [
          "npx compodoc -p tsconfig.lib.json -d ${PWD%/{projectRoot}}/dist/compodoc/{projectName} -n {projectName}"
        ],
        "cwd": "{projectRoot}"
      }
    },
    "build-storybook": {
      "dependsOn": ["build-storybook-compodoc"],
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/.storybook/**/*",
        {
          "externalDependencies": ["storybook", "@storybook/angular"]
        }
      ],
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "{workspaceRoot}/dist/storybook/{projectName}",
        "styles": ["libs/internal/storybook/src/themes/all-themes.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/design-system/src/sass", "libs/internal/storybook/src/themes"]
        }
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook-compodoc": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        {
          "externalDependencies": ["@compodoc/compodoc"]
        }
      ],
      "outputs": ["{projectRoot}/.storybook/compodoc/documentation.json"],
      "options": {
        "commands": [
          "npx compodoc -p tsconfig.lib.json -d .storybook/compodoc -n {projectName} -e json --disablePrivate --disableProtected --disableInternal"
        ],
        "cwd": "{projectRoot}"
      }
    },
    "compodoc": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "commands": [
          "npx compodoc -p tsconfig.lib.json -d ${PWD%/{projectRoot}}/dist/compodoc/{projectName} -n {projectName} --serve --watch"
        ],
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/libs/tooling/eslint-plugin/index.js",
        "{workspaceRoot}/libs/tooling/eslint-plugin/configs/*.js"
      ],
      "configurations": {
        "fix": {
          "fix": true
        }
      }
    },
    "nx-release-publish": {
      "dependsOn": ["build"],
      "executor": "@nx/js:release-publish",
      "options": {
        "packageRoot": "{workspaceRoot}/dist/{projectRoot}"
      }
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "continuous": true,
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "{projectName}:build:production"
        },
        "development": {
          "buildTarget": "{projectName}:build:development"
        }
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "continuous": true,
      "options": {
        "buildTarget": "{projectName}:build",
        "staticFilePath": "{workspaceRoot}/dist/{projectRoot}/browser",
        "spa": true
      }
    },
    "serve-static-storybook": {
      "options": {
        "staticFilePath": "{workspaceRoot}/dist/storybook/{projectName}"
      }
    },
    "storybook": {
      "dependsOn": ["build-storybook-compodoc"],
      "options": {
        "port": 4400,
        "styles": ["libs/internal/storybook/src/themes/all-themes.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/design-system/src/sass", "libs/internal/storybook/src/themes"]
        }
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "include": ["**/*.spec.ts", "../!(src|.storybook)/**/*.spec.ts"],
        "coverage": true,
        "coverageInclude": ["{projectRoot}/**/*.ts"],
        "coverageExclude": [
          "{projectRoot}/**/index.ts",
          "{projectRoot}/**/main.ts",
          "{projectRoot}/**/test-setup.ts",
          "{projectRoot}/.storybook/**/*.ts",
          "{projectRoot}/**/*.stories.ts"
        ],
        "coverageReporters": ["html", "lcovonly", "json-summary", "text-summary"],
        "coverageThresholds": {
          "branches": 85,
          "functions": 85,
          "lines": 85,
          "statements": 85
        },
        "watch": false
      },
      "configurations": {
        "watch": {
          "watch": true
        }
      }
    }
  },
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "none",
      "prefix": "ang",
      "style": "scss",
      "tags": "application",
      "unitTestRunner": "vitest-angular"
    },
    "@nx/angular:component": {
      "style": "scss",
      "changeDetection": "OnPush",
      "displayBlock": true,
      "prefix": "ang"
    },
    "@nx/angular:directive": {
      "prefix": "ang"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "vitest-angular",
      "changeDetection": "OnPush",
      "displayBlock": true,
      "prefix": "ang",
      "publishable": true,
      "style": "scss",
      "tags": "library"
    },
    "@nx/angular:library-secondary-entry-point": {
      "skipModule": true
    }
  },
  "release": {
    "groups": {
      "libraries": {
        "projects": ["analytics", "cdk", "common", "core", "design-system", "labs"],
        "projectsRelationship": "fixed",
        "releaseTag": {
          "pattern": "v{version}"
        },
        "changelog": {
          "createRelease": false
        }
      },
      "applications": {
        "projects": ["libs/applications/*"],
        "projectsRelationship": "independent",
        "releaseTag": {
          "pattern": "{projectName}@{version}"
        }
      },
      "tooling": {
        "projects": ["libs/tooling/*"],
        "projectsRelationship": "independent",
        "releaseTag": {
          "pattern": "{projectName}@{version}"
        }
      }
    },
    "version": {
      "preVersionCommand": "npx nx run-many -t build --projects=tag:library,tag:tooling",
      "manifestRootsToUpdate": [
        "{projectRoot}",
        {
          "path": "{workspaceRoot}/dist/{projectRoot}",
          "preserveLocalDependencyProtocols": false
        }
      ],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "preserveMatchingDependencyRanges": ["dependencies", "devDependencies", "optionalDependencies"]
    },
    "changelog": {
      "automaticFromRef": true,
      "projectChangelogs": {
        "createRelease": "github"
      }
    }
  },
  "nxCloudId": "69cd387c25091c3aa561c48c"
}
