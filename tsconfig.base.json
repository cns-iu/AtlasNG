{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "target": "es2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "declaration": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "useDefineForClassFields": true,
    "useUnknownInCatchVariables": true,
    "paths": {
      "@atlasng/analytics": ["./libs/analytics/src/index.ts"],
      "@atlasng/analytics/events": ["./libs/analytics/events/src/index.ts"],
      "@atlasng/analytics/permissions": ["./libs/analytics/permissions/src/index.ts"],
      "@atlasng/cdk": ["./libs/cdk/src/index.ts"],
      "@atlasng/common": ["./libs/common/src/index.ts"],
      "@atlasng/core": ["./libs/core/src/index.ts"],
      "@atlasng/design-system": ["./libs/design-system/src/index.ts"],
      "@atlasng/design-system/buttons": ["./libs/design-system/buttons/src/index.ts"],
      "@atlasng/design-system/buttons/breadcrumbs": ["./libs/design-system/buttons/breadcrumbs/src/index.ts"],
      "@atlasng/design-system/buttons/help": ["./libs/design-system/buttons/help/src/index.ts"],
      "@atlasng/design-system/buttons/navigation": ["./libs/design-system/buttons/navigation/src/index.ts"],
      "@atlasng/design-system/buttons/navigation-toggle": [
        "./libs/design-system/buttons/navigation-toggle/src/index.ts"
      ],
      "@atlasng/design-system/buttons/social-media": ["./libs/design-system/buttons/social-media/src/index.ts"],
      "@atlasng/design-system/cookie-banner": ["./libs/design-system/cookie-banner/src/index.ts"],
      "@atlasng/design-system/indicators": ["./libs/design-system/indicators/src/index.ts"],
      "@atlasng/design-system/indicators/end-of-results": [
        "./libs/design-system/indicators/end-of-results/src/index.ts"
      ],
      "@atlasng/design-system/indicators/no-results": ["./libs/design-system/indicators/no-results/src/index.ts"],
      "@atlasng/design-system/indicators/results": ["./libs/design-system/indicators/results/src/index.ts"],
      "@atlasng/design-system/text-link": ["./libs/design-system/text-link/src/index.ts"],
      "@atlasng/labs": ["./libs/labs/src/index.ts"],
      "@atlasng/labs/cookie-modal": ["./libs/labs/cookie-modal/src/index.ts"],
      "@atlasng/labs/footer": ["./libs/labs/footer/src/index.ts"],
      "@atlasng/labs/section-header": ["./libs/labs/section-header/src/index.ts"],
      "@atlasng/labs/youtube-player": ["./libs/labs/youtube-player/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"],
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictStandalone": true,
    "strictTemplates": true
  }
}
